rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seminar Hall documents
    match /seminarHalls/{hallId} {
      allow read, write: if true;
    }

    // Games catalog
    match /games/{gameId} {
      allow read, write: if true;
    }

    // Game Attempts
    match /gameAttempts/{attemptId} {
      allow read, write: if true;
    }

    // Registered students per hall
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Game Sessions for history
    match /gameSessions/{sessionId} {
      allow read, write: if true;
    }

    // Test and all fallback documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
